<?php

/**
 * @property integer $id
 * @property string $product_name
 * @property integer $quantity_bulk
 * @property integer $quantity_single
 * @property string $unit_price_bulk
 * @property string $unit_price_single
 * @property string $discount_1
 * @property string $discount_2
 * @property string $discount_3
 * @property string $discount_4
 * @property string $discount_5
 * @property integer $order_header_id
 * @property integer $product_id
 * @property integer $unit_id
 * @property integer $is_inactive
 * @property integer $quantity_delivery
 * @property integer $quantity_remaining
 * @property integer $quantity_purchase
 * @property integer $quantity_invoice
 * @property string $unit_price_after_discount
 *
 * @property DeliveryDetail[] $deliveryDetails
 * @property OrderHeader $orderHeader
 * @property Product $product
 * @property Unit $unit
 * @property PackingListDetail[] $packingListDetails
 * @property PurchaseDetail[] $purchaseDetails
 */
class OrderDetailBase extends ActiveRecord {

    public function tableName() {
        return 'tbldl_order_detail';
    }

    public function rules() {
        return array(
            array('product_name, order_header_id, product_id, unit_id', 'required'),
            array('quantity_bulk, quantity_single, order_header_id, product_id, unit_id, is_inactive, quantity_delivery, quantity_remaining, quantity_purchase, quantity_invoice', 'numerical', 'integerOnly' => true),
            array('product_name', 'length', 'max' => 60),
            array('unit_price_bulk, unit_price_single, discount_1, discount_2, discount_3, discount_4, discount_5, unit_price_after_discount', 'length', 'max' => 18),
            // The following rule is used by search().
            array('id, product_name, quantity_bulk, quantity_single, unit_price_bulk, unit_price_single, discount_1, discount_2, discount_3, discount_4, discount_5, order_header_id, product_id, unit_id, is_inactive, quantity_delivery, quantity_remaining, quantity_purchase, unit_price_after_discount, quantity_invoice', 'safe', 'on' => 'search'),
        );
    }

    public function relations() {
        return array(
            'deliveryDetails' => array(self::HAS_MANY, 'DeliveryDetail', 'order_detail_id'),
            'orderHeader' => array(self::BELONGS_TO, 'OrderHeader', 'order_header_id'),
            'product' => array(self::BELONGS_TO, 'Product', 'product_id'),
            'unit' => array(self::BELONGS_TO, 'Unit', 'unit_id'),
            'packingListDetails' => array(self::HAS_MANY, 'PackingListDetail', 'order_detail_id'),
            'purchaseDetails' => array(self::HAS_MANY, 'PurchaseDetail', 'order_detail_id'),
        );
    }

    public function attributeLabels() {
        return array(
            'id' => 'ID',
            'product_name' => 'Product Name',
            'quantity_bulk' => 'Quantity Bulk',
            'quantity_single' => 'Quantity Single',
            'unit_price_bulk' => 'Unit Price Bulk',
            'unit_price_single' => 'Unit Price Single',
            'discount_1' => 'Discount 1',
            'discount_2' => 'Discount 2',
            'discount_3' => 'Discount 3',
            'discount_4' => 'Discount 4',
            'discount_5' => 'Discount 5',
            'order_header_id' => 'Order Header',
            'product_id' => 'Product',
            'unit_id' => 'Unit',
            'is_inactive' => 'Is Inactive',
            'quantity_delivery' => 'Quantity Delivery',
            'quantity_remaining' => 'Quantity Remaining',
            'quantity_purchase' => 'Quantity Purchase',
            'quantity_invoice' => 'Quantity Invoice',
            'unit_price_after_discount' => 'Unit Price After Discount',
        );
    }

    public function search() {
        $criteria = new CDbCriteria;

        $criteria->compare('id', $this->id);
        $criteria->compare('product_name', $this->product_name, true);
        $criteria->compare('quantity_bulk', $this->quantity_bulk);
        $criteria->compare('quantity_single', $this->quantity_single);
        $criteria->compare('unit_price_bulk', $this->unit_price_bulk, true);
        $criteria->compare('unit_price_single', $this->unit_price_single, true);
        $criteria->compare('discount_1', $this->discount_1, true);
        $criteria->compare('discount_2', $this->discount_2, true);
        $criteria->compare('discount_3', $this->discount_3, true);
        $criteria->compare('discount_4', $this->discount_4, true);
        $criteria->compare('discount_5', $this->discount_5, true);
        $criteria->compare('order_header_id', $this->order_header_id);
        $criteria->compare('product_id', $this->product_id);
        $criteria->compare('unit_id', $this->unit_id);
        $criteria->compare('is_inactive', $this->is_inactive);
        $criteria->compare('quantity_delivery', $this->quantity_delivery);
        $criteria->compare('quantity_remaining', $this->quantity_remaining);
        $criteria->compare('quantity_purchase', $this->quantity_purchase);
        $criteria->compare('quantity_invoice', $this->quantity_invoice);
        $criteria->compare('unit_price_after_discount', $this->unit_price_after_discount, true);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
        ));
    }

}
