<?php

class OrderOutstandingController extends Controller {

    public function filters() {
        return array(
            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'report') {
            if (!(Yii::app()->user->checkAccess('orderReport'))) {
                $this->redirect(array('/site/login'));
            }
        }

        $filterChain->run();
    }

    public function actionReport() {
        $orderHeader = Search::bind(new OrderHeader('search'), isset($_GET['OrderHeader']) ? $_GET['OrderHeader'] : array());
        $endDate = (isset($_GET['EndDate'])) ? $_GET['EndDate'] : date('Y-m-d');
        $dataProvider = $orderHeader->searchByOutstanding();
        
        if (!empty($endDate)) {
            $dataProvider->criteria->addCondition('t.date <= :date');
            $dataProvider->criteria->params[':date'] = $endDate;
        }

        $dataProvider->criteria->order = 't.id ASC';

        if (isset($_GET['SaveExcel'])) {
            $this->saveToExcel($dataProvider, $endDate);
        }

        $this->render('report', array(
            'dataProvider' => $dataProvider,
            'orderHeader' => $orderHeader,
            'endDate' => $endDate,
        ));
    }
    
    protected function saveToExcel($dataProvider, $endDate) {
        set_time_limit(0);
        ini_set('memory_limit', '1024M');

        spl_autoload_unregister(array('YiiBase', 'autoload'));
        include_once Yii::getPathOfAlias('ext.phpexcel.Classes') . DIRECTORY_SEPARATOR . 'PHPExcel.php';
        spl_autoload_register(array('YiiBase', 'autoload'));

        $objPHPExcel = new PHPExcel();

        $documentProperties = $objPHPExcel->getProperties();
        $documentProperties->setCreator('Djaja Listrik');
        $documentProperties->setTitle('Sales Order Outstanding');

        $worksheet = $objPHPExcel->setActiveSheetIndex(0);
        $worksheet->setTitle('Sales Order Outstanding');

        $worksheet->mergeCells('A1:L1');
        $worksheet->mergeCells('A2:L2');
        $worksheet->mergeCells('A3:L3');

        $worksheet->getStyle('A1:L5')->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_CENTER);
        $worksheet->getStyle('A1:L5')->getFont()->setBold(true);

        $worksheet->setCellValue('A1', 'Djaja Listrik');
        $worksheet->setCellValue('A2', 'Sales Order Outstanding');
        $worksheet->setCellValue('A3', 'Sampai Tanggal: ' . Yii::app()->dateFormatter->format('d MMMM yyyy', strtotime($endDate)));

        $worksheet->getStyle('A5:L5')->getBorders()->getTop()->setBorderStyle(PHPExcel_Style_Border::BORDER_THICK);

        $worksheet->setCellValue('A5', 'Order #');
        $worksheet->setCellValue('B5', 'Branch');
        $worksheet->setCellValue('C5', 'Tanggal');
        $worksheet->setCellValue('D5', 'Customer');
        $worksheet->setCellValue('E5', 'PO Customer');
        $worksheet->setCellValue('F5', 'Note Internal');
        $worksheet->setCellValue('G5', 'PO #');
        $worksheet->setCellValue('H5', 'Pengiriman #');
        $worksheet->setCellValue('I5', 'Invoice #');
        $worksheet->setCellValue('J5', 'User');
        $worksheet->setCellValue('K5', 'Total Order (Rp)');
        $worksheet->setCellValue('L5', 'Total Invoice (Rp)');

        $worksheet->getStyle('A4:L5')->getBorders()->getBottom()->setBorderStyle(PHPExcel_Style_Border::BORDER_THICK);

        $counter = 6;
        $grandTotalOrder = '0.00';
        $grandTotalInvoice = '0.00';
        foreach ($dataProvider->data as $header) {
            $worksheet->getStyle("K{$counter}:L{$counter}")->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_RIGHT);
            $grandTotal = CHtml::value($header, 'grandTotal');
            $totalInvoice = CHtml::value($header, 'totalInvoice');

            $worksheet->setCellValue("A{$counter}", CHtml::value($header, 'number'));
            $worksheet->setCellValue("B{$counter}", CHtml::value($header, 'branch.code'));
            $worksheet->setCellValue("C{$counter}", CHtml::value($header, 'date'));
            $worksheet->setCellValue("D{$counter}", CHtml::value($header, 'customer.company'));
            $worksheet->setCellValue("E{$counter}", CHtml::value($header, 'reference_number'));
            $worksheet->setCellValue("F{$counter}", CHtml::value($header, 'note_internal'));
            $worksheet->setCellValue("G{$counter}", CHtml::value($header, 'purchaseNumber'));
            $worksheet->setCellValue("H{$counter}", CHtml::value($header, 'deliveryNumber'));
            $worksheet->setCellValue("I{$counter}", CHtml::value($header, 'invoiceNumber'));
            $worksheet->setCellValue("J{$counter}", CHtml::value($header, 'admin.name'));
            $worksheet->setCellValue("K{$counter}", $grandTotal);
            $worksheet->setCellValue("L{$counter}", $totalInvoice);
            
            $grandTotalOrder += $grandTotal;
            $grandTotalInvoice += $totalInvoice;

            $counter++;
        }
        
        $worksheet->getStyle("A{$counter}:L{$counter}")->getBorders()->getTop()->setBorderStyle(PHPExcel_Style_Border::BORDER_THICK);
        $worksheet->setCellValue("J{$counter}", 'TOTAL');
        $worksheet->setCellValue("K{$counter}", $grandTotalOrder);
        $worksheet->setCellValue("L{$counter}", $grandTotalInvoice);
        $counter++;

        for ($col = 'A'; $col !== 'z'; $col++) {
            $objPHPExcel->getActiveSheet()
            ->getColumnDimension($col)
            ->setAutoSize(true);
        }
        
        ob_end_clean();
        // We'll be outputting an excel file
        header('Content-type: application/vnd.ms-excel');
        header('Content-Disposition: attachment;filename="sales_order_outstanding.xls"');
        header('Cache-Control: max-age=0');
        
        $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel5');
        $objWriter->save('php://output');

        Yii::app()->end();
    }
}
