<?php
CHtml::refresh(300);

$this->breadcrumbs = array(
    'Sales Order' => array('create'),
    'Manage',
);

Yii::app()->clientScript->registerScript('admin', "
    $('form').submit(function(){
        $.fn.yiiGridView.update('order-grid', {
            data: $(this).serialize()
        });
        
        return false;
    });
");
?>

<?php if (Yii::app()->user->hasFlash('success')): ?>
    <div class="flash-success">
        <?php echo Yii::app()->user->getFlash('success'); ?>
    </div>
<?php elseif (Yii::app()->user->hasFlash('failed')): ?>
    <div class="flash-error">
        <?php echo Yii::app()->user->getFlash('failed'); ?>
    </div>
<?php else: ?>
    <div></div>
<?php endif; ?>

<h1>Kelola Data Sales Order</h1>
<div id="detail_div">
    <p>
        You may optionally enter a comparison operator (<b>&lt;</b>, <b>&lt;=</b>, <b>&gt;</b>, <b>&gt;=</b>, <b>&lt;&gt;</b>
        or <b>=</b>) at the beginning of each of your search values to specify how the comparison should be done.
    </p>

    <div id="link">
        <?php echo CHtml::link('Create', array('create'), array('target' => '_blank')); ?>
        <?php echo CHtml::link('View', '#', array('id' => 'ViewLink', 'target' => '_blank', 'style' => 'display: none')); ?>
        <?php echo CHtml::link('Outstanding', array('outstanding'), array('target' => '_blank', 'class' => 'right', 'style' => 'color: blue; font-weight: bold')); ?>
    </div>

    <br />

    <?php echo CHtml::beginForm(); ?>
    <div>
        Page Size:
        <?php echo CHtml::dropDownList('PageSize', '', array(
            10 => '10', 
            25 => '25', 
            50 => '50', 
            100 => '100'
        ), array('onchange' => '$("form").submit();',)); ?>

        Filter by Date: 
        <?php $this->widget('zii.widgets.jui.CJuiDatePicker', array(
            'name' => 'OrderHeaderDate',
            // additional javascript options for the date picker plugin
            'options' => array(
                'dateFormat' => 'yy-mm-dd',
                'onSelect' => 'js:function(dateText, inst) {
                    $("form").submit();
                }',
            ),
            'htmlOptions' => array('readonly' => true,),
        )); ?>

        <?php echo CHtml::button('Semua Tanggal', array('onclick' => '$("#OrderHeaderDate").val(""); $("form").submit();')); ?>
    </div>
    <?php echo CHtml::endForm(); ?>

    <div style="overflow: auto">
        <?php $this->widget('zii.widgets.grid.CGridView', array(
            'id' => 'order-grid',
            'dataProvider' => $dataProvider,
            'filter' => $order,
            'pager' => array('cssFile' => Yii::app()->baseUrl . '/css/transaction/styles.css'),
            'cssFile' => Yii::app()->baseUrl . '/css/transaction/styles.css',
            'selectionChanged' => 'js:function(id) {
                var url = "' . CController::createUrl('view') . '";
                $("#ViewLink").attr("href", url + "&id=" + $.fn.yiiGridView.getSelection(id));
                document.getElementById("ViewLink").click();
            }',
            'columns' => array(
                array(
                    'name' => 'number',
                    'value' => '$data->number',
                    'htmlOptions' => array('width' => '150px'),
                ),
                array(
                    'header' => 'Tanggal',
                    'name' => 'date',
                    'filter' => false,
                    'value' => 'Yii::app()->dateFormatter->format("d MMMM yyyy", $data->date)'
                ),
                array(
                    'name' => 'customer_id',
                    'filter' => CHtml::listData(Customer::model()->findAll(array('order' => 'name ASC')), 'id', 'name'),
                    'value' => '$data->customer->name',
                    'htmlOptions' => array('width' => '200px'),
                ),
                array(
                    'header' => 'Kategori Pelanggan',
                    'value' => '$data->customer->discountCategory->name',
                    'htmlOptions' => array('width' => '100px'),
                ),
                array(
                    'name' => 'admin_id',
                    'header' => 'User',
                    'filter' => CHtml::listData(Admin::model()->findAll(), 'id', 'name'),
                    'value' => '$data->admin->name',
                ),
                array(
                    'name' => 'branch_id',
                    'filter' => CHtml::listData(Branch::model()->findAll(), 'id', 'name'),
                    'value' => '$data->branch->name',
                ),
                array(
                    'header' => 'PO Customer',
                    'name' => 'reference_number',
                    'value' => '$data->reference_number',
                ),
                array(
                    'header' => 'Total',
                    'value' => 'number_format($data->grandTotal, 2)',
                    'htmlOptions' => array(
                        'style' => 'text-align: right',
                    ),
                ),
                array(
                    'name' => 'orderStatus',
                    'filter' => CHtml::dropDownList('OrderStatus', $orderStatus, array('' => '', 0 => 'Close', 1 => 'Open')),
                    'value' => '$data->orderStatus',
                ),
                'note_internal',
                array(
                    'class' => 'CButtonColumn',
                    'template' => $buttonTemplate,
                ),
            ),
        )); ?>
    </div>
</div>
