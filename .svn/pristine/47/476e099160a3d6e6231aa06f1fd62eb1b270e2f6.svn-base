    public function instantiate($id) {
        if (empty($id))
            $order = new Order(new OrderHeader(), array(), array());
        else {
            $orderHeader = $this->loadModel($id);
            $order = new Order($orderHeader, $orderHeader->orderDetails(array('scopes' => 'resetScope')), $orderHeader->orderNewProducts(array('scopes' => 'resetScope')));
        }

        return $order;
    }

    public function loadModel($id) {
        $model = OrderHeader::model()->findByPk($id);
        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        return $model;
    }

    public function loadState($order) {
        if (isset($_POST['OrderHeader'])) {
            $order->header->attributes = $_POST['OrderHeader'];
        }

        if (isset($_POST['OrderDetail'])) {
            foreach ($_POST['OrderDetail'] as $i => $item) {
                if (isset($order->details[$i]))
                    $order->details[$i]->attributes = $item;
                else {
                    $detail = new OrderDetail();
                    $detail->attributes = $item;
                    $order->details[] = $detail;
                }
            }
            if (count($_POST['OrderDetail']) < count($order->details))
                array_splice($order->details, $i + 1);
        }
        else
            $order->details = array();

        if (isset($_POST['OrderNewProduct'])) {
            foreach ($_POST['OrderNewProduct'] as $i => $item) {
                if (isset($order->newProducts[$i]))
                    $order->newProducts[$i]->attributes = $item;
                else {
                    $detail = new OrderNewProduct();
                    $detail->attributes = $item;
                    $order->newProducts[] = $detail;
                }
            }
            if (count($_POST['OrderNewProduct']) < count($order->newProducts))
                array_splice($order->newProducts, $i + 1);
        }
        else
            $order->newProducts = array();
    }

}

?>
