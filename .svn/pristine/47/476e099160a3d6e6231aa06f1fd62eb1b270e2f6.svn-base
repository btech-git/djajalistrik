    public function actionReport() {
        $orderHeader = Search::bind(new OrderHeader('search'), isset($_GET['OrderHeader']) ? $_GET['OrderHeader'] : array());

        $startDate = (isset($_GET['StartDate'])) ? $_GET['StartDate'] : '';
        $endDate = (isset($_GET['EndDate'])) ? $_GET['EndDate'] : '';
        $pageSize = (isset($_GET['PageSize'])) ? $_GET['PageSize'] : '';
        $currentPage = (isset($_GET['page'])) ? $_GET['page'] : '';
        $currentSort = (isset($_GET['sort'])) ? $_GET['sort'] : '';

        $orderReport = new OrderReport($orderHeader->search());
        $orderReport->setupLoading();
        $orderReport->setupPaging($pageSize, $currentPage);
        $orderReport->setupSorting();
        $orderReport->setupFilter($startDate, $endDate);

        $this->render('report', array(
            'orderReport' => $orderReport,
            'orderHeader' => $orderHeader,
            'startDate' => $startDate,
            'endDate' => $endDate,
            'currentSort' => $currentSort,
        ));
    }

    public function actionAdmin() {
        $order = Search::bind(new OrderHeader('search'), isset($_GET['OrderHeader']) ? $_GET['OrderHeader'] : array());

        $customerName = isset($_GET['CustomerName']) ? $_GET['CustomerName'] : '';
        $orderStatus = (isset($_GET['OrderStatus'])) ? $_GET['OrderStatus'] : '';

        $pageSize = (isset($_GET['PageSize'])) ? $_GET['PageSize'] : 10;
        $orderHeaderDate = (isset($_GET['OrderHeaderDate'])) ? $_GET['OrderHeaderDate'] : '';

        $dataProvider = $order->search();
        if ($orderStatus !== '') {
            $str = ($orderStatus !== '0') ? '' : 'NOT';
            $dataProvider->criteria->addCondition("{$str} EXISTS (" .
                "SELECT quantity_single - quantity_purchase AS remaining "
                . "FROM " . OrderDetail::model()->tableName() . " "
                . " WHERE order_header_id = t.id AND quantity_single - COALESCE(quantity_purchase, 0) > 0 AND is_inactive = 0
            )");
        }

        $dataProvider->criteria->with = array(
            'branch:resetScope',
            'customer:resetScope',
            'admin:resetScope',
        );
        
        if (!empty($customerName)) {
            $dataProvider->criteria->addCondition('customer.name LIKE :customer_name');
            $dataProvider->criteria->params[':customer_name'] = "%{$customerName}%";
        }
        
        $dataProvider->criteria->order = 't.id DESC';
        $dataProvider->pagination->pageSize = $pageSize;
        
        if (!empty($orderHeaderDate)) {
            $dataProvider->criteria->addCondition('t.date = :date');
            $dataProvider->criteria->params[':date'] = $orderHeaderDate;
        }

        $buttonTemplate = '{view}';
        if (Yii::app()->user->checkAccess('orderEdit'))
            $buttonTemplate .= '{update}';
        if (Yii::app()->user->checkAccess('administrator'))
            $buttonTemplate .= '{delete}';

        $this->render('admin', array(
            'order' => $order,
            'orderStatus' => $orderStatus,
            'dataProvider' => $dataProvider,
            'customerName' => $customerName,
            'buttonTemplate' => $buttonTemplate,
        ));
    }

