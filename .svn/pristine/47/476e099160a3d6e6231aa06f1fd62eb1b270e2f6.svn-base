    public function actionDelete($id) {
        if (Yii::app()->request->isPostRequest) {
            $orderHeader = $this->loadModel($id);
            $purchaseHeader = PurchaseHeader::model()->findByAttributes(array('order_header_id' => $id, 'is_inactive' => 0));
            $packingListHeader = PackingListHeader::model()->findByAttributes(array('order_header_id' => $id, 'is_inactive' => 0));
            $deliveryHeader = DeliveryHeader::model()->findByAttributes(array('order_header_id' => $id, 'is_inactive' => 0));
            

            if ($orderHeader !== null && empty($purchaseHeader) && empty($packingListHeader) && empty($deliveryHeader)) {
                $orderHeader->is_inactive = !$orderHeader->is_inactive;
                $orderHeader->update(array('is_inactive'));
                
                if (count($orderHeader->orderDetails) > 0) {
                    foreach ($orderHeader->orderDetails as $detail) {
                        $detail->is_inactive = ActiveRecord::INACTIVE;
                        $detail->update(array('is_inactive'));
                    }
                }
                
                if (count($orderHeader->orderNewProducts) > 0) {
                    foreach ($orderHeader->orderNewProducts as $detail) {
                        $detail->is_inactive = ActiveRecord::INACTIVE;
                        $detail->update(array('is_inactive'));
                    }
                }
                
                Yii::app()->user->setFlash('success', "Data is deleted!");
                
            } else {
                Yii::app()->user->setFlash('failed', "Data can't be deleted!");
            }
                
            $this->redirect(array('admin'));
        }
        else
            throw new CHttpException(400, 'Invalid request. Please do not repeat this request again.');
    }

    public function actionAjaxHtmlAddProduct($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $order = $this->instantiate($id);

            $this->loadState($order);

            if (isset($_POST['ProductId']))
                $order->addDetail($_POST['ProductId']);

            $this->renderPartial('_detail', array(
                'order' => $order,
                'error' => false,
            ));
        }
    }

    public function actionAjaxHtmlAddEmptyDetail($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $order = $this->instantiate($id);

            $this->loadState($order);

            $detail = new OrderNewProduct();
            $detail->unit_id = 1;
            $order->newProducts[] = $detail;

            $this->renderPartial('_newProduct', array(
                'order' => $order,
                'error' => false,
            ));
        }
    }

    public function actionAjaxJsonCustomer($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $customerId = (isset($_POST['OrderHeader']['customer_id'])) ? $_POST['OrderHeader']['customer_id'] : '';

            $customer = Customer::model()->findByPk($customerId, array('scopes' => 'resetScope', 'with' => 'discountCategory:resetScope'));

            $object = array(
                'customer_id' => CHtml::value($customer, 'id'),
                'customer_name' => CHtml::value($customer, 'name'),
                'customer_company' => CHtml::value($customer, 'company'),
                'customer_address_1' => CHtml::value($customer, 'address_1'),
                'customer_city' => CHtml::value($customer, 'city'),
                'customer_credit_limit' => Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($customer, 'remainingCreditLimit')),
                'customer_discount_category' => CHtml::value($customer, 'discountCategory.name'),
                'customer_salesman' => CHtml::value($customer, 'salesman.name'),
            );
            echo CJSON::encode($object);
        }
    }

    public function actionAjaxHtmlRemoveDetail($id, $index) {
