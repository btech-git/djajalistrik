        <?php echo CHtml::link('Outstanding', array('outstanding'), array('target' => '_blank', 'class' => 'right', 'style' => 'color: blue; font-weight: bold')); ?>
    </div>

    <br />

    <?php echo CHtml::beginForm(); ?>
