        <th class="width1-3">Supplier</th>
        <th class="width1-4">Branch</th>
        <th class="width1-5">Admin</th>
        <th class="width1-6">Catatan</th>
    </tr>
    
    <tr id="header2">
        <td colspan="6">
            <table>
                <tr>
                    <th class="width2-1">Pembelian #</th>
                    <th class="width2-2">Tanggal Pembelian</th>
                    <th class="width2-3">Penerimaan #</th>
