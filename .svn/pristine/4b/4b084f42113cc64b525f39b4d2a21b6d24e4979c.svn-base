        <?php if ((int) $orderHeader->is_approved === 1): ?>
            <?php echo CHtml::link('Print SO', array('memoOrder', 'id' => $orderHeader->id), array('target' => '_blank')); ?>
            <?php echo CHtml::link('Print Invoice', array('memo', 'id' => $orderHeader->id), array('target' => '_blank')); ?>
        <?php endif; ?><br /><br /><br />
        
        <?php echo CHtml::beginForm(); ?>
        <?php if (Yii::app()->user->checkAccess('administrator')): ?>
            <?php if ((int) $orderHeader->is_approved === 0): ?>
                <?php echo CHtml::submitButton('APPROVED', array('name' => 'Update', 'style' => 'background-color: lightgreen')); ?>
            <?php elseif ((int) $orderHeader->is_approved === 1): ?>
                <?php if ((int) $orderHeader->is_hold === 0): ?>
                    <?php echo CHtml::submitButton('HOLD', array('name' => 'Hold', 'style' => 'background-color: red; font-weight: bold')); ?>
                    <?php echo CHtml::submitButton('CLEARED', array('name' => 'Cleared', 'style' => 'background-color: lightgreen; font-weight: bold')); ?>
                    <?php echo CHtml::submitButton('CANCELED', array('name' => 'Canceled', 'style' => 'background-color: yellow; font-weight: bold')); ?>
                <?php endif; ?>
            <?php endif; ?>
        <?php endif; ?>
        <?php echo CHtml::endForm(); ?>
    </div>
