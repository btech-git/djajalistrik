body
{
	margin: 0;
	padding: 0;
	color: #555;
	font: normal 10pt Arial,Helvetica,sans-serif;
	background: #EFEFEF;
}

#page
{
	margin-top: 5px;
	margin-bottom: 5px;
	background: white;
	border: 1px solid #C9E0ED;
}

#header
{
	margin: 0;
	padding: 0;
	border-bottom: 1px solid #C00;
}

#content
{
    padding: 20px;
}

#content-memo
{
    padding:20px 20px;
}

#sidebar
{
	padding: 20px 20px 20px 0;
}

#footer
{
	padding: 10px;
	margin: 10px 20px;
	font-size: 0.8em;
	text-align: center;
}

#logo
{
	padding: 10px 20px;
	font-size: 200%;
}
#login
{
	padding: 10px 20px;
	font-size: 14px;
	float: right;
	margin:15px 15px;
}
#login a
{
	font-weight: bold;
	text-decoration: none;
}

div.flash-error, div.flash-notice, div.flash-success
{
	padding:.8em;
	margin-bottom:1em;
	border:2px solid #ddd;
}

div.flash-error
{
	background:#FBE3E4;
	color:#8a1f11;
	border-color:#FBC2C4;
}

div.flash-notice
{
	background:#FFF6BF;
	color:#514721;
	border-color:#FFD324;
}

div.flash-success
{
	background:#E6EFC2;
	color:#264409;
	border-color:#C6D880;
}

div.flash-error a
{
	color:#8a1f11;
}

div.flash-notice a
{
	color:#514721;
}

div.flash-success a
{
	color:#264409;
}

div.view
{
	padding: 10px;
	margin: 10px 0;
	border: 1px solid #C9E0ED;
}

div.breadcrumbs
{
	font-size: 0.9em;
	padding: 5px 20px;
}

div.breadcrumbs span
{
	font-weight: bold;
}

div.search-form
{
	padding: 10px;
	margin: 10px 0;
	background: #F5DEB3;
}

div.search-form label
{
	float: left;
	margin-right: 10px;
	margin-top: 10px;
	position: relative;
	text-align: right;
	width: 100px;
}

div.search-form .row
{
	clear: left;
}

.portlet
{

}

.portlet-decoration
{
	padding: 3px 10px;
	background: #C00;
	border-left: 5px solid red;
}

.portlet-title
{
	font-size: 12px;
	font-weight: bold;
	padding: 0;
	margin: 0;
	color: #ffffff;
}

.portlet-content
{
	font-size:0.9em;
	margin: 0 0 15px 0;
	padding: 5px 8px;
	background:#C00;
}

.portlet-content ul
{
	list-style-image:none;
	list-style-position:outside;
	list-style-type:none;
	margin: 0;
	padding: 0;
}

.portlet-content li
{
	padding: 2px 0 4px 0px;
}

.operations
{
	list-style-type: none;
	margin: 0;
	padding: 0;
}

.operations li
{
	padding-bottom: 2px;
}

.operations li a
{
	font: bold 12px Arial;
	color: #ffffff;
	display: block;
	padding: 2px 0 2px 8px;
	line-height: 15px;
	text-decoration: none;
}

.operations li a:visited
{
	color: firebrick;
}

.operations li a:hover
{
	 color: #ffffff;
	 background: firebrick;
}

ol, ul, accordion {
  padding: 0;
  border: 0;
}

#body_content {
	width: 1200px;
}

#body_left_column {
	float: left;
	width: 250px;
}

#body_right_column {
	width: 1050px;	
	margin-top: 15px;
	margin-left: 5px;
}

#detail_div
{
	width: 1050px;
}

#detail_new_product {
    width: 920px;
}

#detail_div_memo
{
	width: 100%;
}

.accordion{ display: block; width: 230px; margin-left: 20px; margin-top: 21px; }
.accordion, .accordion li{margin-left: 10px;padding: 0px; border: none; list-style: none;}
.accordion a {padding: 10px 10px 10px 15px;  background-color: #900; text-decoration:none; display: block; color: #fff; }
.accordion ul a {padding: 10px 10px 10px 30px;}
.accordion a.dcjq-parent, .accordion a.dcjq-parent:hover {padding: 10px 10px 10px 15px;}
.accordion a.dcjq-parent.active {background: #cd0a0a;}
.accordion a.active {background: #cd0a0a;}
.accordion a:hover{background: #cd0a0a;}
.accordion a.open{background: #cd0a0a;}
.accordion a:active{}

