            <td style="text-align: right">
                <span id="total<?php echo $i; ?>">
                <?php echo CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($newProduct, 'total'))); ?>
                </span>
            </td>
            <td>
                <?php if ($newProduct->isNewRecord): ?>
                    <?php echo CHtml::button('Delete', array(
                        'onclick' => CHtml::ajax(array(
                            'type' => 'POST',
                            'url' => CController::createUrl('ajaxHtmlRemoveNewProduct', array('id' => $order->header->id, 'index' => $i)),
                            'update' => '#new_product_div',
                        )),
                    )); ?>
                <?php else: ?>
                    <?php echo CHtml::activeDropDownList($newProduct, "[$i]is_inactive", array(ActiveRecord::ACTIVE => 'Active', ActiveRecord::INACTIVE => 'Inactive'), array(
                        'onchange' => CHtml::ajax(array(
                            'type' => 'POST',
                            'dataType' => 'JSON',
                            'url' => CController::createUrl('ajaxJsonTotalNewProduct', array('id' => $order->header->id, 'index' => $i)),
                            'success' => 'function(data) {
                                $("#unit_price_' . $i . '").html(data.unit_price);
                                $("#total_' . $i . '").html(data.total);
                                $("#total_new_product").html(data.totalNewProduct);	
                                $("#grand_total").html(data.grandTotal);
                                $("#tax").html(data.tax);
                            }',
                        )),
                    )); ?>
                <?php endif; ?>
            </td>
        </tr>
    <?php endforeach; ?>
        
    <tr style="background-color: #F5DEB3">
        <td colspan="9" style="text-align: right; font-weight: bold">Total:</td>
        <td style="text-align: right; font-weight: bold">
            <span id="total_new_product">
                <?php echo CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', ($order->totalNewProduct > 1000000) ? round($order->totalNewProduct, -3) : round($order->totalNewProduct, -2))); ?>
            </span>
        </td>
        <td></td>
    </tr>
</table>
