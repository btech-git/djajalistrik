                ?>
                <?php echo CHtml::error($newProduct, 'discount_3'); ?>
            </td>
            <td style="text-align: center">
                <?php
                echo CHtml::activeTextField($newProduct, "[$i]discount_4", array('size' => 3, 'maxLength' => 10,
                    'onchange' => CHtml::ajax(array(
                        'type' => 'POST',
                        'dataType' => 'JSON',
                        'url' => CController::createUrl('ajaxJsonTotalNewProduct', array('id' => $order->header->id, 'index' => $i)),
                        'success' => 'function(data) {
                            $("#unit_price' . $i . '").html(data.unit_price);
