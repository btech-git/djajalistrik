                            $("#total_new_product").html(data.totalNewProduct);
                            $("#grand_total").html(data.grandTotal);
                            $("#tax").html(data.tax);
                        }',
                    )),
                )); ?>
                <?php echo CHtml::error($newProduct, 'discount_1'); ?>
            </td>
