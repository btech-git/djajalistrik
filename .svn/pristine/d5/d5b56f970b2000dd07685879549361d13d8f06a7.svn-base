<?php

/**
 * @property integer $id
 * @property string $name
 * @property string $address
 * @property string $tax_number
 * @property string $phone
 * @property string $fax
 * @property string $cn_constant
 * @property integer $cn_ordinal_start
 * @property integer $cn_ordinal_end
 * @property integer $is_tax
 * @property integer $is_inactive
 * @property string $bank_name
 * @property string $bank_account_number
 * @property string $bank_account_name
 * @property string $filename
 * @property string $code
 *
 * @property AdjustmentHeader[] $adjustmentHeaders
 * @property Admin[] $admins
 * @property DeliveryHeader[] $deliveryHeaders
 * @property DepositHeader[] $depositHeaders
 * @property ExpenseHeader[] $expenseHeaders
 * @property Inventory[] $inventories
 * @property Invoice[] $invoices
 * @property InvoiceHeader[] $invoiceHeaders
 * @property OrderHeader[] $orderHeaders
 * @property PackingListHeader[] $packingListHeaders
 * @property PurchaseHeader[] $purchaseHeaders
 * @property PurchasePaymentHeader[] $purchasePaymentHeaders
 * @property PurchaseReceiptHeader[] $purchaseReceiptHeaders
 * @property PurchaseReturnHeader[] $purchaseReturnHeaders
 * @property QuotationHeader[] $quotationHeaders
 * @property ReceiptTemporaryHeader[] $receiptTemporaryHeaders
 * @property ReceiveHeader[] $receiveHeaders
 * @property SalePaymentHeader[] $salePaymentHeaders
 * @property SaleReceiptHeader[] $saleReceiptHeaders
 * @property SaleReturnHeader[] $saleReturnHeaders
 * @property Taxform[] $taxforms
 * @property TransferHeader[] $transferHeaders
 */
class BranchBase extends ActiveRecord
{
	public function tableName()
	{
		return 'tbldl_branch';
	}

	public function rules()
	{
		return array(
			array('name', 'required'),
			array('cn_ordinal_start, cn_ordinal_end, is_tax, is_inactive', 'numerical', 'integerOnly'=>true),
			array('name, tax_number, phone, fax, bank_name, bank_account_name, filename', 'length', 'max'=>60),
			array('cn_constant, bank_account_number, code', 'length', 'max'=>20),
			array('address', 'safe'),
			// The following rule is used by search().
			array('id, name, address, tax_number, phone, fax, cn_constant, cn_ordinal_start, cn_ordinal_end, is_tax, is_inactive, bank_name, bank_account_number, bank_account_name, filename, code', 'safe', 'on'=>'search'),
		);
	}

	public function relations()
	{
		return array(
			'adjustmentHeaders' => array(self::HAS_MANY, 'AdjustmentHeader', 'branch_id'),
			'admins' => array(self::HAS_MANY, 'Admin', 'branch_id'),
			'deliveryHeaders' => array(self::HAS_MANY, 'DeliveryHeader', 'branch_id'),
			'depositHeaders' => array(self::HAS_MANY, 'DepositHeader', 'branch_id'),
			'expenseHeaders' => array(self::HAS_MANY, 'ExpenseHeader', 'branch_id'),
			'inventories' => array(self::HAS_MANY, 'Inventory', 'branch_id'),
			'invoices' => array(self::HAS_MANY, 'Invoice', 'branch_id'),
			'invoiceHeaders' => array(self::HAS_MANY, 'InvoiceHeader', 'branch_id'),
			'orderHeaders' => array(self::HAS_MANY, 'OrderHeader', 'branch_id'),
			'packingListHeaders' => array(self::HAS_MANY, 'PackingListHeader', 'branch_id'),
			'purchaseHeaders' => array(self::HAS_MANY, 'PurchaseHeader', 'branch_id'),
			'purchasePaymentHeaders' => array(self::HAS_MANY, 'PurchasePaymentHeader', 'branch_id'),
			'purchaseReceiptHeaders' => array(self::HAS_MANY, 'PurchaseReceiptHeader', 'branch_id'),
			'purchaseReturnHeaders' => array(self::HAS_MANY, 'PurchaseReturnHeader', 'branch_id'),
			'quotationHeaders' => array(self::HAS_MANY, 'QuotationHeader', 'branch_id'),
			'receiptTemporaryHeaders' => array(self::HAS_MANY, 'ReceiptTemporaryHeader', 'branch_id'),
			'receiveHeaders' => array(self::HAS_MANY, 'ReceiveHeader', 'branch_id'),
			'salePaymentHeaders' => array(self::HAS_MANY, 'SalePaymentHeader', 'branch_id'),
			'saleReceiptHeaders' => array(self::HAS_MANY, 'SaleReceiptHeader', 'branch_id'),
			'saleReturnHeaders' => array(self::HAS_MANY, 'SaleReturnHeader', 'branch_id'),
			'taxforms' => array(self::HAS_MANY, 'Taxform', 'branch_id'),
			'transferHeaders' => array(self::HAS_MANY, 'TransferHeader', 'branch_id'),
		);
	}

	public function attributeLabels()
	{
		return array(
			'id' => 'ID',
			'name' => 'Name',
			'address' => 'Address',
			'tax_number' => 'Tax Number',
			'phone' => 'Phone',
			'fax' => 'Fax',
			'cn_constant' => 'Cn Constant',
			'cn_ordinal_start' => 'Cn Ordinal Start',
			'cn_ordinal_end' => 'Cn Ordinal End',
			'is_tax' => 'Is Tax',
			'is_inactive' => 'Is Inactive',
			'bank_name' => 'Bank Name',
			'bank_account_number' => 'Bank Account Number',
			'bank_account_name' => 'Bank Account Name',
			'filename' => 'Filename',
			'code' => 'Code',
		);
	}

	public function search()
	{
		$criteria = new CDbCriteria;

		$criteria->compare('id', $this->id);
		$criteria->compare('name', $this->name, true);
		$criteria->compare('address', $this->address, true);
		$criteria->compare('tax_number', $this->tax_number, true);
		$criteria->compare('phone', $this->phone, true);
		$criteria->compare('fax', $this->fax, true);
		$criteria->compare('cn_constant', $this->cn_constant, true);
		$criteria->compare('cn_ordinal_start', $this->cn_ordinal_start);
		$criteria->compare('cn_ordinal_end', $this->cn_ordinal_end);
		$criteria->compare('is_tax', $this->is_tax);
		$criteria->compare('is_inactive', $this->is_inactive);
		$criteria->compare('bank_name', $this->bank_name, true);
		$criteria->compare('bank_account_number', $this->bank_account_number, true);
		$criteria->compare('bank_account_name', $this->bank_account_name, true);
		$criteria->compare('filename', $this->filename, true);
		$criteria->compare('code', $this->code, true);

		return new CActiveDataProvider($this, array(
			'criteria'=>$criteria,
		));
	}
}