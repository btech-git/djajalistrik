<?php

class InvoiceController extends Controller {

    public function filters() {
        return array(
            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'admin' || $filterChain->action->id === 'view') {
            if (!(Yii::app()->user->checkAccess('invoiceCreate') || Yii::app()->user->checkAccess('invoiceEdit')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'create' || $filterChain->action->id === 'taxform' || $filterChain->action->id === 'ajaxHtmlShowOrder' || $filterChain->action->id === 'ajaxJsonOrder' || $filterChain->action->id === 'ajaxJsonTotal' || $filterChain->action->id === 'ajaxHtmlRemoveDetail' || $filterChain->action->id === 'memo') {
            if (!(Yii::app()->user->checkAccess('invoiceCreate')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'delete' || $filterChain->action->id === 'update') {
            if (!(Yii::app()->user->checkAccess('invoiceEdit')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'report') {
            if (!(Yii::app()->user->checkAccess('invoiceReport')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }

    public function actionOrderList() {

        $orderHeader = Search::bind(new OrderHeader('search'), isset($_GET['OrderHeader']) ? $_GET['OrderHeader'] : '');
        $orderHeaderDataProvider = $orderHeader->searchByInvoice();
        $orderHeaderDataProvider->criteria->with = array(
            'customer',
            'branch',
            'admin'
        );

        $pageSize = (isset($_GET['PageSize'])) ? $_GET['PageSize'] : 10;
        $invoiceHeaderDate = (isset($_GET['InvoiceHeaderDate'])) ? $_GET['InvoiceHeaderDate'] : '';

        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';
        if (!empty($customerCompany)) {
            $orderHeaderDataProvider->criteria->addCondition('customer.company LIKE :customer_company');
            $orderHeaderDataProvider->criteria->params[':customer_company'] = "%{$customerCompany}%";
        }

        if (!empty($invoiceHeaderDate)) {
            $orderHeaderDataProvider->criteria->addCondition('t.date = :date');
            $orderHeaderDataProvider->criteria->params[':date'] = $invoiceHeaderDate;
        }

        $orderHeaderDataProvider->criteria->order = 't.date DESC';
        $orderHeaderDataProvider->pagination->pageSize = $pageSize;

        $this->render('orderList', array(
            'orderHeader' => $orderHeader,
            'orderHeaderDataProvider' => $orderHeaderDataProvider,
            'customerCompany' => $customerCompany,
        ));
    }

    public function actionCreate($orderHeaderId) {
        $invoice = $this->instantiate(null);
        $orderHeader = OrderHeader::model()->findByPk($orderHeaderId);
        
        $invoice->header->order_header_id = $orderHeaderId;
        $invoice->header->customer_id = $orderHeader->customer_id;
        $invoice->header->branch_id = $orderHeader->branch_id;
        $invoice->header->is_tax = $orderHeader->is_tax;
        $invoice->header->tax_percentage = $orderHeader->tax;
        $invoice->header->is_include = $orderHeader->is_include;
        $invoice->header->deposit = $orderHeader->deposit;
        $invoice->header->shipping_fee = $orderHeader->shipping_fee;
        $invoice->header->admin_id = Yii::app()->user->id;

        $deliveryDetail = Search::bind(new DeliveryDetail('search'), isset($_GET['DeliveryDetail']) ? $_GET['DeliveryDetail'] : array());
        $deliveryDetailDataProvider = $deliveryDetail->searchForInvoice();

        $deliveryDetailDataProvider->criteria->with = array(
            'deliveryHeader' => array(
                'with' => array(
                    'orderHeader'
                ),
            ),
        );

        if (!empty($orderHeaderId)) {
            $deliveryDetailDataProvider->criteria->addCondition("deliveryHeader.order_header_id = :order_header_id");
            $deliveryDetailDataProvider->criteria->params[':order_header_id'] = $orderHeaderId;
        }

        $deliveryNewProduct = Search::bind(new DeliveryNewProduct('search'), isset($_GET['DeliveryNewProduct']) ? $_GET['DeliveryNewProduct'] : array());
        $deliveryNewProductDataProvider = $deliveryNewProduct->searchForInvoice();

        $deliveryNewProductDataProvider->criteria->with = array(
            'deliveryHeader' => array(
                'with' => array(
                    'orderHeader'
                ),
            ),
        );

        if (!empty($orderHeaderId)) {
            $deliveryNewProductDataProvider->criteria->addCondition("deliveryHeader.order_header_id = :order_header_id");
            $deliveryNewProductDataProvider->criteria->params[':order_header_id'] = $orderHeaderId;
        }

        if (isset($_POST['Submit'])) {
            $this->loadState($invoice);
            $invoice->header->number = CodeNumber::make($invoice->header, 'number', 'INV', Yii::app()->user, $invoice->header->branch_id);

            if ($invoice->header->is_tax == 1) {
                $invoice->header->tax_number = '000.00-0000';
            }
            
            if ($invoice->save(Yii::app()->db)) {
                $this->redirect(array('view', 'id' => $invoice->header->id));
            }
        }

        if (isset($_POST['Cancel'])) {
            $this->redirect(array('admin'));
        }

        $this->render('create', array(
            'invoice' => $invoice,
            'orderHeader' => $orderHeader,
            'deliveryDetail' => $deliveryDetail,
            'deliveryDetailDataProvider' => $deliveryDetailDataProvider,
            'deliveryNewProduct' => $deliveryNewProduct,
            'deliveryNewProductDataProvider' => $deliveryNewProductDataProvider,
        ));
    }

    public function actionUpdate($id) {
        $invoice = $this->instantiate($id);

        $deliveryDetail = Search::bind(new DeliveryDetail('search'), isset($_GET['DeliveryDetail']) ? $_GET['DeliveryDetail'] : array());
        $deliveryDetailDataProvider = $deliveryDetail->searchForInvoice();

        $deliveryDetailDataProvider->criteria->with = array(
            'deliveryHeader' => array(
                'with' => array(
                    'orderHeader'
                ),
            ),
        );

        if (!empty($invoice->header->order_header_id)) {
            $deliveryDetailDataProvider->criteria->addCondition("deliveryHeader.order_header_id = :order_header_id");
            $deliveryDetailDataProvider->criteria->params[':order_header_id'] = $invoice->header->order_header_id;
        }

        $deliveryNewProduct = Search::bind(new DeliveryNewProduct('search'), isset($_GET['DeliveryNewProduct']) ? $_GET['DeliveryNewProduct'] : array());
        $deliveryNewProductDataProvider = $deliveryNewProduct->searchForInvoice();

        $deliveryNewProductDataProvider->criteria->with = array(
            'deliveryHeader' => array(
                'with' => array(
                    'orderHeader'
                ),
            ),
        );

        if (!empty($invoice->header->order_header_id)) {
            $deliveryNewProductDataProvider->criteria->addCondition("deliveryHeader.order_header_id = :order_header_id");
            $deliveryNewProductDataProvider->criteria->params[':order_header_id'] = $invoice->header->order_header_id;
        }

        if (isset($_POST['Submit'])) {
            $this->loadState($invoice);
                
            if ($invoice->save(Yii::app()->db)) {
                $this->redirect(array('view', 'id' => $invoice->header->id));
            }
        }

        if (isset($_POST['Cancel'])) {
            $this->redirect(array('admin'));
        }
        
        $this->render('update', array(
            'invoice' => $invoice,
            'deliveryDetail' => $deliveryDetail,
            'deliveryDetailDataProvider' => $deliveryDetailDataProvider,
            'deliveryNewProduct' => $deliveryNewProduct,
            'deliveryNewProductDataProvider' => $deliveryNewProductDataProvider,
        ));
    }

    public function actionView($id) {
        $invoice = $this->loadModel($id);

        $criteria = new CDbCriteria;
        $criteria->compare('invoice_header_id', $invoice->id);
        
        $detailsDataProvider = new CActiveDataProvider('InvoiceDetail', array(
            'criteria' => $criteria,
        ));

        $newProductsDataProvider = new CActiveDataProvider('InvoiceNewProduct', array(
            'criteria' => $criteria,
        ));

        $this->render('view', array(
            'invoice' => $invoice,
            'detailsDataProvider' => $detailsDataProvider,
            'newProductsDataProvider' => $newProductsDataProvider
        ));
    }

    public function actionMemo($id) {
        $this->layout = '//layouts/blank';

        if (!(Yii::app()->user->checkAccess('administrator'))) {
            if (!(isset(Yii::app()->session['InvoiceMemoAllowed']) && Yii::app()->session['InvoiceMemoAllowed'] === true))
                $this->redirect(array('admin'));
        }

        Yii::app()->session->remove('InvoiceMemoAllowed');
        $invoice = $this->loadModel($id);

        $branch = $invoice->branch(array('scopes' => 'resetScope'));
        $orderHeader = $invoice->orderHeader(array(
            'scopes' => 'resetScope',
            'with' => array(
                'customer:resetScope'
            )
        ));

        $this->render('memo', array(
            'invoice' => $invoice,
            'orderHeader' => $orderHeader,
            'branch' => $branch,
        ));
    }

