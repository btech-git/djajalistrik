                    'style'=>'text-align: right',
                ),
            ),
            array(
                'class' => 'CButtonColumn',
                'template' => $buttonTemplate,
                'buttons' => array(
                    'view' => array(
                        'url' => 'Yii::app()->createUrl("/transaction/purchaseReceipt/view", array("id" => $data->purchase_receipt_header_id))'
                    ),
                    'update' => array(
                        'url' => 'Yii::app()->createUrl("/transaction/purchaseReceipt/update", array("id" => $data->purchase_receipt_header_id))'
                    ),
                ),
            ),
        ),
    )); ?>
