<div>
    <?php $this->beginWidget('zii.widgets.jui.CJuiDialog', array(
        'id' => 'delivery-detail-dialog',
        // additional javascript options for the dialog plugin
        'options' => array(
            'title' => 'Pengiriman Stok',
            'autoOpen' => false,
            'width' => 'auto',
            'modal' => true,
        ),
    )); ?>

    <?php echo CHtml::beginForm('', 'post'); ?>
    <?php $this->widget('zii.widgets.grid.CGridView', array(
        'id' => 'delivery-detail-grid',
        'dataProvider' => $deliveryDetailDataProvider,
        'filter' => $deliveryDetail,
        'columns' => array(
            array(
                'id' => 'selectedIds',
                'class' => 'CCheckBoxColumn',
                'selectableRows' => '50',
            ),
            array(
                'header' => 'Pengiriman #',
                'value' => '$data->deliveryHeader->number',
                'htmlOptions' => array('style' => 'width: 200px'),
            ),
            array(
                'header' => 'Tanggal',
                'name' => 'date',
                'filter' => false,
                'value' => 'Yii::app()->dateFormatter->format("d MMM yyyy", $data->deliveryHeader->date)'
            ),
            'orderDetail.product_name: Product',
            'quantity',
            'orderDetail.unit.name: Satuan',
        ),
    )); ?>

    <?php echo CHtml::ajaxSubmitButton('Add Pengiriman Stok', CController::createUrl('ajaxHtmlAddDeliveryDetails', array('id' => $invoice->header->id)), array(
        'type' => 'POST',
        'data' => 'js:$("form").serialize()',
        'success' => 'js:function(html) {
            $("#detail_div").html(html);
            $("#delivery-detail-dialog").dialog("close");
            $.ajax({
                type: "POST",
                url: "' . CController::createUrl('ajaxHtmlUpdateTotals', array('id' => $invoice->header->id, 'orderHeaderId' => $invoice->header->order_header_id)) . '",
                data: $("form").serialize(),
                success: function(html) {
                    $("#total_div").html(html);
                }
            });
        }'
    )); ?>

    <?php echo CHtml::endForm(); ?>

    <?php $this->endWidget('zii.widgets.jui.CJuiDialog'); ?>
</div>

<div>
    <?php $this->beginWidget('zii.widgets.jui.CJuiDialog', array(
        'id' => 'delivery-new-item-dialog',
        // additional javascript options for the dialog plugin
        'options' => array(
            'title' => 'Pengiriman non stok',
            'autoOpen' => false,
            'width' => 'auto',
            'modal' => true,
        ),
    )); ?>

    <?php echo CHtml::beginForm('', 'post'); ?>
    <?php $this->widget('zii.widgets.grid.CGridView', array(
        'id' => 'delivery-new-item-grid',
        'dataProvider' => $deliveryNewProductDataProvider,
        'filter' => $deliveryNewProduct,
        'columns' => array(
            array(
                'id' => 'selectedNewProductIds',
                'class' => 'CCheckBoxColumn',
                'selectableRows' => '50',
            ),
            array(
                'header' => 'Pengiriman #',
                'value' => '$data->deliveryHeader->number',
                'htmlOptions' => array('style' => 'width: 200px'),
            ),
            array(
                'header' => 'Tanggal',
                'name' => 'date',
                'filter' => false,
                'value' => 'Yii::app()->dateFormatter->format("d MMM yyyy", $data->deliveryHeader->date)'
            ),
            'orderNewProduct.name: Product',
            'quantity',
            'orderNewProduct.unit.name: Satuan',
        ),
    )); ?>

    <?php echo CHtml::ajaxSubmitButton('Add Pengiriman non stok', CController::createUrl('ajaxHtmlAddDeliveryNewProducts', array('id' => $invoice->header->id)), array(
        'type' => 'POST',
        'data' => 'js:$("form").serialize()',
        'success' => 'js:function(html) {
            $("#detail_new_product").html(html);
            $("#delivery-new-item-dialog").dialog("close");
            $.ajax({
                type: "POST",
                url: "' . CController::createUrl('ajaxHtmlUpdateTotals', array('id' => $invoice->header->id)) . '",
                data: $("form").serialize(),
                success: function(html) {
                    $("#total_div").html(html);
                }
            });
        }'
    )); ?>

    <?php echo CHtml::endForm(); ?>

    <?php $this->endWidget('zii.widgets.jui.CJuiDialog'); ?>
</div>