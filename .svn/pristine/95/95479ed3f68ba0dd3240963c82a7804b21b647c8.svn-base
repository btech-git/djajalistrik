                <?php echo CHtml::label('PO Customer', false); ?>
                <?php echo CHtml::encode(CHtml::value($invoice->header, 'orderHeader.reference_number')); ?>
            </div>
            
            <div class="row">
                <?php echo CHtml::label('Customer', false); ?>
                <?php echo CHtml::encode(CHtml::value($invoice->header, 'orderHeader.customer.name')); ?>
            </div>
            
            <?php if ($invoice->header->is_tax == 0): ?>
                <div class="row">
                    <?php echo CHtml::label('Include / Exclude PPN', false); ?>
