        <hr />

        <div class="row">
            <?php echo CHtml::button('Tambah Item Stok', array('name' => 'Search', 'onclick' => '$("#delivery-detail-dialog").dialog("open"); return false;', 'onkeypress' => 'if (event.keyCode == 13) { $("#delivery-detail-dialog").dialog("open"); return false; }')); ?>
            <?php echo CHtml::button('Tambah Item Non-Stok', array('name' => 'Search', 'onclick' => '$("#delivery-new-item-dialog").dialog("open"); return false;', 'onkeypress' => 'if (event.keyCode == 13) { $("#delivery-new-item-dialog").dialog("open"); return false; }')); ?>
        </div>

        <div id="detail_div" style="width: 920px;">
            <?php $this->renderPartial('_detail', array(
                'invoice' => $invoice, 
