            </div>
        </div>
        
        <div class="span-12 last">
            <div class="row">
                <?php echo CHtml::label('SO #', false); ?>
                <?php echo CHtml::encode(CHtml::value($invoice->header, 'orderHeader.number')); ?>
            </div>
            
            <div class="row">
                <?php echo CHtml::label('SO Date', false); ?>
                <?php echo CHtml::encode(CHtml::value($invoice->header, 'orderHeader.date')); ?>
            </div>
            
