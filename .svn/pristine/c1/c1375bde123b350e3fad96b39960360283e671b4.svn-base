                )); ?>
                <?php echo CHtml::error($newProduct, 'discount_2'); ?>
            </td>
            <td style="text-align: center">
                <?php echo CHtml::activeTextField($newProduct, "[$i]discount_3", array('size' => 3, 'maxLength' => 10,
                    'onchange' => CHtml::ajax(array(
                        'type' => 'POST',
                        'dataType' => 'JSON',
                        'url' => CController::createUrl('ajaxJsonTotalNewProduct', array('id' => $purchase->header->id, 'index' => $i)),
                        'success' => 'function(data) {
                            $("#unit_price' . $i . '").html(data.unit_price);
                            $("#price_after_discount_' . $i . '").html(data.price_after_discount);
                            $("#total' . $i . '").html(data.total);
                            $("#total_new_product").html(data.totalNewProduct);	
                            $("#sub_total").html(data.subTotal);
                            $("#tax").html(data.tax);
                            $("#grand_total").html(data.grandTotal);
                        }',
                    )),
                )); ?>
                <?php echo CHtml::error($newProduct, 'discount_3'); ?>
            </td>
            <td style="text-align: center">
                <?php echo CHtml::activeTextField($newProduct, "[$i]discount_4", array('size' => 3, 'maxLength' => 10,
                    'onchange' => CHtml::ajax(array(
                        'type' => 'POST',
                        'dataType' => 'JSON',
                        'url' => CController::createUrl('ajaxJsonTotalNewProduct', array('id' => $purchase->header->id, 'index' => $i)),
                        'success' => 'function(data) {
                            $("#unit_price' . $i . '").html(data.unit_price);
                            $("#price_after_discount_' . $i . '").html(data.price_after_discount);
                            $("#total' . $i . '").html(data.total);
                            $("#total_new_product").html(data.totalNewProduct);	
                            $("#sub_total").html(data.subTotal);
                            $("#tax").html(data.tax);
                            $("#grand_total").html(data.grandTotal);
                        }',
                    )),
                )); ?>
                <?php echo CHtml::error($newProduct, 'discount_4'); ?>
            </td>
            <td style="text-align: center">
                <?php echo CHtml::activeTextField($newProduct, "[$i]discount_5", array('size' => 3, 'maxLength' => 10,
                    'onchange' => CHtml::ajax(array(
                        'type' => 'POST',
                        'dataType' => 'JSON',
                        'url' => CController::createUrl('ajaxJsonTotalNewProduct', array('id' => $purchase->header->id, 'index' => $i)),
                        'success' => 'function(data) {
                            $("#unit_price' . $i . '").html(data.unit_price);
                            $("#price_after_discount_' . $i . '").html(data.price_after_discount);
                            $("#total' . $i . '").html(data.total);
                            $("#total_new_product").html(data.totalNewProduct);	
                            $("#sub_total").html(data.subTotal);
                            $("#tax").html(data.tax);
                            $("#grand_total").html(data.grandTotal);
                        }',
