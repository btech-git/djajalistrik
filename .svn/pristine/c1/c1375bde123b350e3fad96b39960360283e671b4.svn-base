<table style="border: 1px solid; width: 950px">
    <tr style="background-color: #cd0a0a; color: white">
        <th style="text-align: center">Nama Barang</th>
        <th style="text-align: center">Brand</th>
        <th style="text-align: center">Jumlah</th>
        <th style="text-align: center">Satuan</th>
        <?php if (!empty($purchase->header->order_header_id)): ?>
            <th style="text-align: center">Harga Jual</th>
        <?php endif; ?>
        <th style="text-align: center">Harga Satuan</th>
        <th style="text-align: center">+/-(%) 1</th>
        <th style="text-align: center">+/-(%) 2</th>
        <th style="text-align: center">+/-(%) 3</th>
        <th style="text-align: center">+/-(%) 4</th>
        <th style="text-align: center">+/-(%) 5</th>
        <th style="text-align: center">Unit Price</th>
        <th style="text-align: center">Total</th>
        <th>&nbsp;</th>
    </tr>
    <?php foreach ($purchase->newProducts as $i => $newProduct): ?>
        <tr style="background-color: #FFF8DC">
            <td>
                <?php echo CHtml::activeHiddenField($newProduct, "[$i]order_new_product_id"); ?>
                <?php echo CHtml::activeTextField($newProduct, "[$i]product_name", array('size' => 30, 'maxLength' => 60)); ?>
            </td>
            
            <td>
                <?php echo CHtml::activeDropDownList($newProduct, "[$i]brand_id", CHtml::listData(Brand::model()->active()->findAll(array('order' => 'name ASC')), 'id', 'name'), array('empty' => '- Brand -')); ?>
            </td>
            
            <td style="text-align:center">
                <?php echo CHtml::activeTextField($newProduct, "[$i]quantity", array('size' => 7, 'maxLength' => 20,
                    'onchange' => CHtml::ajax(array(
                        'type' => 'POST',
                        'dataType' => 'JSON',
                        'url' => CController::createUrl('ajaxJsonTotalNewProduct', array('id' => $purchase->header->id, 'index' => $i)),
                        'success' => 'function(data) {
                            $("#unit_price_' . $i . '").html(data.unit_price);
                            $("#price_after_discount_' . $i . '").html(data.price_after_discount);
                            $("#total' . $i . '").html(data.total);
                            $("#total_new_product").html(data.totalNewProduct);	
                            $("#sub_total").html(data.subTotal);
                            $("#tax").html(data.tax);
                            $("#grand_total").html(data.grandTotal);
                        }',
                    )),
                )); ?>
                <?php echo CHtml::error($newProduct, 'quantity'); ?>
            </td>

            <td>
                <?php echo CHtml::activeDropDownList($newProduct, "[$i]unit_id", CHtml::listData(Unit::model()->active()->findAll(array('order' => 'name ASC')), 'id', 'name'), array('empty' => '- Satuan -')); ?>
            </td>

            <?php if (!empty($purchase->header->order_header_id)): ?>
                <td style="text-align:center">
                    <?php echo CHtml::activeHiddenField($newProduct, "[$i]unit_price_sale_order"); ?>
                    <?php echo CHtml::encode(Yii::app()->numberFormatter->format('#,##0', $newProduct->unit_price_sale_order)); ?>
                </td>
            <?php endif; ?>

            <td style="text-align: center">
                <?php echo CHtml::activeTextField($newProduct, "[$i]unit_price", array(
                    'size' => 10,
                    'maxLength' => 20,
                    'onchange' =>
//                    (empty($purchase->header->order_header_id)) ? '' :
//                    'if (parseInt($(this).val()) > parseInt($("#' . CHtml::activeId($newProduct, "[$i]unit_price_sale_order") . '").val())) $(this).val($("#' . CHtml::activeId($newProduct, "[$i]unit_price_sale_order") . '").val());' .
                    CHtml::ajax(array(
                        'type' => 'POST',
                        'dataType' => 'JSON',
                        'url' => CController::createUrl('ajaxJsonTotalNewProduct', array('id' => $purchase->header->id, 'index' => $i)),
                        'success' => 'function(data) {
                            $("#unit_price' . $i . '").html(data.unit_price);
                            $("#price_after_discount_' . $i . '").html(data.price_after_discount);
                            $("#total' . $i . '").html(data.total);
                            $("#total_new_product").html(data.totalNewProduct);
                            $("#sub_total").html(data.subTotal);
                            $("#tax").html(data.tax);
                            $("#grand_total").html(data.grandTotal);
                        }',
                    )),
                )); ?>
                <div id="unit_price<?php echo $i; ?>" style="text-align: left; font-size: smaller">
                    <?php echo CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($newProduct, 'unit_price'))); ?>
                </div>
                <?php echo CHtml::error($newProduct, 'unit_price'); ?>
            </td>
            
            <td style="text-align: center">
                <?php echo CHtml::activeTextField($newProduct, "[$i]discount_1", array('size' => 3, 'maxLength' => 10,
                    'onchange' => CHtml::ajax(array(
                        'type' => 'POST',
                        'dataType' => 'JSON',
                        'url' => CController::createUrl('ajaxJsonTotalNewProduct', array('id' => $purchase->header->id, 'index' => $i)),
                        'success' => 'function(data) {
                            $("#unit_price' . $i . '").html(data.unit_price);
                            $("#price_after_discount_' . $i . '").html(data.price_after_discount);
                            $("#total' . $i . '").html(data.total);
                            $("#total_new_product").html(data.totalNewProduct);
                            $("#sub_total").html(data.subTotal);
                            $("#tax").html(data.tax);
                            $("#grand_total").html(data.grandTotal);
                        }',
                    )),
                ));
                ?>
                <?php echo CHtml::error($newProduct, 'discount_1'); ?>
            </td>
            <td style="text-align: center">
                <?php echo CHtml::activeTextField($newProduct, "[$i]discount_2", array('size' => 3, 'maxLength' => 10,
                    'onchange' => CHtml::ajax(array(
