    <tr style="background-color: #F5DEB3">
        <td colspan=<?php echo (!empty($purchase->header->order_header_id)) ? '12' : '11'; ?> style="text-align: right; font-weight: bold">Total:</td>
        <td style="text-align: right; font-weight: bold">
            <span id="total_new_product">
                <?php echo CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', ($purchase->totalNewProduct > 1000000) ? round($purchase->totalNewProduct, -3) : round($purchase->totalNewProduct, -2))); ?>
            </span>
        </td>
        <td>&nbsp;</td>
    </tr>
</table>
